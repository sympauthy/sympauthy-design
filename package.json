{
  "name": "@sympauthy/design",
  "version": "0.3.0",
  "private": true,
  "description": "The SympAuthy design system: tokens, Tailwind theme, shared Vue components and branding helpers for sympauthy-flow and sympauthy-admin.",
  "license": "GPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sympauthy/sympauthy-design.git"
  },
  "homepage": "https://sympauthy.github.io/sympauthy-design/",
  "files": [
    "dist",
    "src",
    "logos",
    "tokens.json"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./dist/theme.css",
    "./tokens.css": "./dist/tokens.css",
    "./tokens-light.css": "./dist/tokens-light.css",
    "./components.css": "./src/components.css",
    "./fonts.css": "./src/fonts.css",
    "./tokens.json": "./tokens.json",
    "./logos/*": "./logos/*"
  },
  "scripts": {
    "build": "node scripts/build-theme.mjs",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "pages:dev": "npm run build && vitepress dev pages",
    "pages:build": "npm run build && vitepress build pages",
    "pages:preview": "vitepress preview pages",
    "format": "prettier --write src docs pages scripts",
    "format:check": "prettier --check src docs pages scripts",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@heroicons/vue": "^2.1.3"
  },
  "peerDependencies": {
    "reka-ui": "^2.10.4",
    "tailwindcss": "^4.2.1",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@vue/tsconfig": "^0.9.0",
    "prettier": "^3.0.3",
    "reka-ui": "^2.10.4",
    "tailwindcss": "^4.2.1",
    "typescript": "~6.0.0",
    "vitepress": "^2.0.0-alpha.15",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0"
  }
}
